# Copiar a ".env" para probar localmente. Al desplegar en Render, estas
# mismas variables se configuran en el Dashboard (Environment → Environment
# Variables) — ver DEPLOY.md. Nunca subir el ".env" real a git.

# Clave maestra para desbloquear "ver contraseña" cuando un admin se
# equivoca 3 veces (opcional — si no se define, esa función queda
# deshabilitada, igual que en el sistema actual).
CLAVE_MAESTRA_DESBLOQUEO=

# Si en algún momento se activa el envío de notificaciones por WhatsApp
# (ver notificaciones.js, hoy solo deja un registro en el log):
WHATSAPP_PROVEEDOR=
WHATSAPP_TELEFONO_ID=
WHATSAPP_TOKEN=
